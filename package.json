{
  "name": "next-round-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1 <27",
    "pnpm": ">=12.14.0"
  },
  "scripts": {
    "build": "pnpm -r run build && pnpm check:browser-bundle",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:sprint2": "node scripts/sprint2-acceptance.mjs",
    "test:f0": "node scripts/f0-acceptance.mjs",
    "test:sprint3": "node scripts/sprint3-evidence.mjs",
    "test:sprint4": "node scripts/sprint4-evidence.mjs",
    "check:browser-bundle": "node scripts/check-browser-bundle.mjs",
    "check:spdx": "node scripts/check-spdx.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.8",
    "eslint": "9.20.0",
    "prettier": "3.5.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
