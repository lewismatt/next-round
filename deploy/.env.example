# Next Round Environment Configuration Example
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Persistence (PostgreSQL 18.6 / 17.x)
POSTGRES_DB=next_round
POSTGRES_USER=next_round
POSTGRES_PASSWORD=next_round_local
DATABASE_URL=postgres://next_round:next_round_local@localhost:5432/next_round

# Security & Sessions
# Minimum 64-character random hex string for signing session cookies
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Operator-provided secret for first admin account initialization (/api/v1/setup)
SETUP_SECRET=dev_setup_token_change_in_prod

# Caddy Domain
CADDY_DOMAIN=localhost
