# Next Round Environment Configuration Example
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Persistence (PostgreSQL 18.6 / 17.x)
POSTGRES_DB=next_round
POSTGRES_USER=next_round
POSTGRES_PASSWORD=
# Independent 32-byte random hex password for non-superuser next_round_runtime.
RUNTIME_DATABASE_PASSWORD=
# Direct local API/worker use: set DATABASE_URL to the runtime role URL.
# Compose constructs runtime URLs itself; bootstrap POSTGRES_* stays in migrate/postgres.
DATABASE_URL=
# Optional non-transaction-pooled migration/API/worker listener connection.
# Must use next_round_runtime and the same application database in Compose.
# All listeners and migrations fall back to DATABASE_URL when this is blank.
DATABASE_DIRECT_URL=
# In Compose use the postgres service hostname, not localhost.

# API per-node live recovery and worker reconciliation interval, in milliseconds.
# Default 10000. Must be an integer from 1 through 86400000; invalid values fail boot.
LIVE_RECONCILE_INTERVAL_MS=10000

# Security & Sessions
# Cookie plugin secret; current opaque session cookies are unsigned (see README).
# Minimum 64-character independently generated random hex string.
SESSION_SECRET=
# Operator-provided secret for first admin account initialization (/api/v1/setup)
SETUP_TOKEN=
# Exact public browser origin. HTTP is accepted only for localhost development.
APP_ORIGIN=https://localhost


# Direct local API: unset/false ignores all forwarded headers. Otherwise provide
# comma-separated IP addresses/CIDRs for proxies you control; never true or *.
TRUST_PROXY=false

# Compose trusts exactly this stable Caddy address on its dedicated proxy network.
# Change both together if the default subnet conflicts with your host network.
PROXY_SUBNET=172.30.0.0/24
CADDY_PROXY_IP=172.30.0.10

# Caddy Domain
CADDY_DOMAIN=localhost

# Optional service-level containment overrides (Compose, not Swarm).
# Defaults assume at least 4 GiB host RAM; measure before reducing.
# API_MEM_LIMIT=1g
# API_CPUS=2.0
# API_PIDS_LIMIT=128
# WORKER_MEM_LIMIT=512m
# WORKER_CPUS=1.0
# WORKER_PIDS_LIMIT=128
# MIGRATE_MEM_LIMIT=512m
# MIGRATE_CPUS=1.0
# MIGRATE_PIDS_LIMIT=128
# POSTGRES_MEM_LIMIT=1g
# POSTGRES_CPUS=2.0
# POSTGRES_PIDS_LIMIT=256
# CADDY_MEM_LIMIT=256m
# CADDY_CPUS=1.0
# CADDY_PIDS_LIMIT=128
